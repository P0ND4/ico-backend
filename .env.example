# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Dominio / SSL ───────────────────────────────────────────────────────────
API_DOMAIN=api.ico-app.org
LANDING_DOMAIN=ico-app.org
CERTBOT_EMAIL=admin@ico-app.org

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ico
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ─── Social Auth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ─── DeepSeek AI ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
